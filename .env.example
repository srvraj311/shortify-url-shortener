# ---------------------------------------------------------------------------
# Copy to .env.local for local development. Set the same keys in the Vercel
# project (Settings -> Environment Variables) for preview + production.
# NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Core ---
# MongoDB Atlas connection string. Use a DEDICATED database for this app.
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="url-shortener-v1"

# 32+ byte random string used to sign/derive session + token material.
# Generate: openssl rand -hex 32
AUTH_SECRET="change-me-openssl-rand-hex-32"

# Public origin of the deployment, no trailing slash. Used to build short URLs.
PUBLIC_BASE_URL="http://localhost:3000"

# --- Redis (Upstash REST) — OPTIONAL. App degrades gracefully when unset. ---
# Create at https://console.upstash.com (free tier) or via Vercel Marketplace.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Feature flags (default shown; unset == default) ---
FEATURE_RATE_LIMIT="true"
FEATURE_REDIS_CACHE="true"
FEATURE_ANALYTICS="true"
FEATURE_ASYNC_ANALYTICS="true"
FEATURE_SEARCH="true"
FEATURE_SSRF_GUARD="true"

# --- Ops ---
# Shared secret required by internal cron/worker endpoints (Vercel Cron sends it).
CRON_SECRET="change-me-openssl-rand-hex-32"
# Raw analytics event retention (days) for the TTL index.
ANALYTICS_EVENT_TTL_DAYS="90"
LOG_LEVEL="info"
